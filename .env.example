# ============================================================
# Affiliate Intelligence & Automation Platform
# Copie para .env e preencha. NUNCA comite o .env.
# ============================================================

# ---------- Aplicação ----------
APP_ENV=local                 # local | staging | production
LOG_LEVEL=INFO
TIMEZONE=America/Sao_Paulo
API_PREFIX=/api/v1

# ---------- Banco ----------
# Local (docker-compose) ou connection string do Supabase (role app_backend).
DATABASE_URL=postgresql+psycopg://mp:mp@localhost:5432/mp

# ---------- Autenticação ----------
# Chave que o n8n envia no header X-API-Key para chamar o backend.
N8N_API_KEY=troque-esta-chave
# Segredo usado para validar o JWT do dashboard (Supabase Auth).
JWT_SECRET=troque-este-segredo
JWT_ALGORITHM=HS256

# Quem pode usar o dashboard (e-mails separados por vírgula). Em produção é obrigatório:
# o Supabase pode ter usuários de outros apps, e todos teriam JWT válido.
DASHBOARD_ALLOWED_EMAILS=

# ---------- Modo de operação (trilhos de segurança) ----------
# Com MOCK ligado nenhum sistema externo é tocado.
MOCK_MARKETPLACE=true
MOCK_ADS=true
# DRY_RUN registra a decisão mas não executa efeito externo.
DRY_RUN=true
# 1..5. Mesmo no nível 5 campanhas nascem PAUSED.
AI_AUTONOMY_LEVEL=1

# ---------- Orçamento e portfólio ----------
MAX_DAILY_AD_SPEND=100.00
MIN_DAILY_TEST_BUDGET=10.00
MIN_ACTIVE_PRODUCTS=3
MAX_ACTIVE_PRODUCTS=15
# Fatia máxima do portfólio que uma categoria nível 1 pode ocupar (%)
MAX_CATEGORY_SHARE_PCT=40

# ---------- Varredura de comissão alta ----------
# Itens por categoria lidos por preço decrescente (teto da API da Shopee: 500).
COMMISSION_SWEEP_PER_CATEGORY=300
# Os DOIS pisos valem: comissão alta sem venda é geladeira de R$ 85 mil que ninguém
# compra por um post, e venda alta sem comissão é o catálogo de R$ 3 por venda.
COMMISSION_SWEEP_MIN_VALUE=15.00
COMMISSION_SWEEP_MIN_SALES=100
EXPLORATION_PERCENTAGE=30
EXPLOITATION_PERCENTAGE=70

# ---------- Maturidade de dado para decisão ----------
MIN_TEST_DURATION_DAYS=3
MIN_CLICKS_FOR_DECISION=50
MIN_IMPRESSIONS_FOR_DECISION=1000
MIN_DATA_FOR_DECISION=1

# ---------- Guardrails de anúncios ----------
MAX_UNREVIEWED_CAMPAIGNS=10
MAX_CAMPAIGNS_PER_EXECUTION=2
MAX_DECISIONS_PER_EXECUTION=3

# ---------- Tracking ----------
SUBID_MAX_LENGTH=48

# ---------- Página pública e contagem de clique ----------
# Base das URLs /go/{sub_id} e /l. SEM isso o post sai com o link de afiliado direto e
# nenhum clique é medido (e sem clique não há CVR nem aprendizado).
PUBLIC_BASE_URL=https://mp.dsearch.com.br
# Sal do hash do visitante (o IP nunca é gravado). Vazio cai no JWT_SECRET.
CLICK_HASH_SALT=
BIO_PAGE_TITLE=Meus achados
BIO_PAGE_SUBTITLE=Seleção de ofertas que eu testei e recomendo.

# ---------- LLM (desligado por padrão) ----------
OPPORTUNITY_USE_LLM=false
LLM_PROVIDER=null             # null | anthropic | gemini
LLM_MODEL=
LLM_DAILY_COST_CAP_USD=1.00
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ---------- Shopee Affiliate (Fase 9) ----------
SHOPEE_API_URL=https://open-api.affiliate.shopee.com.br/graphql
# IDs dos lotes de liquidação (painel de afiliado > Billing), separados por vírgula.
# Sem eles nenhum dia vira SETTLED e o motor nunca corta produto por ROI negativo.
SHOPEE_VALIDATION_IDS=
SHOPEE_APP_ID=
SHOPEE_SECRET=

# ---------- Meta Marketing API (Fase 4) ----------
META_API_VERSION=v21.0
META_AD_ACCOUNT_ID=
META_ACCESS_TOKEN=
