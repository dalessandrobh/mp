# ============================================================
# Affiliate Intelligence & Automation Platform
# Copie para .env e preencha. NUNCA comite o .env.
# ============================================================

# ---------- Aplicação ----------
APP_ENV=local                 # local | staging | production
LOG_LEVEL=INFO
TIMEZONE=America/Sao_Paulo
API_PREFIX=/api/v1

# ---------- Banco ----------
# Local (docker-compose) ou connection string do Supabase (role app_backend).
DATABASE_URL=postgresql+psycopg://mp:mp@localhost:5432/mp

# ---------- Autenticação ----------
# Chave que o n8n envia no header X-API-Key para chamar o backend.
N8N_API_KEY=troque-esta-chave
# Segredo usado para validar o JWT do dashboard (Supabase Auth).
JWT_SECRET=troque-este-segredo
JWT_ALGORITHM=HS256

# ---------- Modo de operação (trilhos de segurança) ----------
# Com MOCK ligado nenhum sistema externo é tocado.
MOCK_MARKETPLACE=true
MOCK_ADS=true
# DRY_RUN registra a decisão mas não executa efeito externo.
DRY_RUN=true
# 1..5. Mesmo no nível 5 campanhas nascem PAUSED.
AI_AUTONOMY_LEVEL=1

# ---------- Orçamento e portfólio ----------
MAX_DAILY_AD_SPEND=100.00
MIN_DAILY_TEST_BUDGET=10.00
MIN_ACTIVE_PRODUCTS=3
MAX_ACTIVE_PRODUCTS=15
EXPLORATION_PERCENTAGE=30
EXPLOITATION_PERCENTAGE=70

# ---------- Maturidade de dado para decisão ----------
MIN_TEST_DURATION_DAYS=3
MIN_CLICKS_FOR_DECISION=50
MIN_IMPRESSIONS_FOR_DECISION=1000
MIN_DATA_FOR_DECISION=1

# ---------- LLM (desligado por padrão) ----------
OPPORTUNITY_USE_LLM=false
LLM_PROVIDER=null             # null | anthropic | gemini
LLM_MODEL=
LLM_DAILY_COST_CAP_USD=1.00
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ---------- Shopee Affiliate (Fase 9) ----------
SHOPEE_API_URL=https://open-api.affiliate.shopee.br/graphql
SHOPEE_APP_ID=
SHOPEE_SECRET=

# ---------- Meta Marketing API (Fase 4) ----------
META_API_VERSION=v21.0
META_AD_ACCOUNT_ID=
META_ACCESS_TOKEN=
