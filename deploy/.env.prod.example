# ============================================================
# Deploy de produção — copie para deploy/.env.prod e preencha.
# NUNCA comite o .env.prod (já está no .gitignore).
#   chmod 600 deploy/.env.prod
# ============================================================

# ---------- Rede Docker do Supabase ----------
# Descubra com:
#   docker inspect supabase-db -f '{{range $k,$v := .NetworkSettings.Networks}}{{$k}}{{end}}'
SUPABASE_NETWORK=supabase_default

# ---------- Banco ----------
# Banco `mp` DEDICADO dentro do Postgres do Supabase — não é o banco `postgres`.
# Isso mantém nossas tabelas fora do alcance do PostgREST por construção.
# O host é o nome do container do Postgres na rede Docker.
DATABASE_URL=postgresql+psycopg://app_backend:TROQUE_ESTA_SENHA@supabase-db:5432/mp

# ---------- Aplicação ----------
APP_ENV=production
LOG_LEVEL=INFO
TIMEZONE=America/Sao_Paulo
API_PREFIX=/api/v1

# ---------- Autenticação ----------
# Chave que o n8n manda no header X-API-Key. Gere com: openssl rand -hex 32
N8N_API_KEY=

# Precisa ser O MESMO segredo do seu Supabase self-hosted (variável JWT_SECRET
# no .env do Supabase). É com ele que o backend valida o login do dashboard na
# Fase 7. Se divergir, o dashboard não autentica.
JWT_SECRET=
JWT_ALGORITHM=HS256

# ---------- Trilhos de segurança ----------
# Mantenha assim no primeiro deploy: nada externo é tocado, nada é gasto.
# Só mude depois que a Fase 4 estiver validada e você quiser rodar de verdade.
MOCK_MARKETPLACE=true
MOCK_ADS=true
DRY_RUN=true
AI_AUTONOMY_LEVEL=1

# ---------- Orçamento e portfólio ----------
MAX_DAILY_AD_SPEND=100.00
MIN_DAILY_TEST_BUDGET=10.00
MIN_ACTIVE_PRODUCTS=3
MAX_ACTIVE_PRODUCTS=15
EXPLORATION_PERCENTAGE=30
EXPLOITATION_PERCENTAGE=70

# ---------- Maturidade de dado ----------
MIN_TEST_DURATION_DAYS=3
MIN_CLICKS_FOR_DECISION=50
MIN_IMPRESSIONS_FOR_DECISION=1000
MIN_DATA_FOR_DECISION=1

# ---------- LLM (desligado) ----------
OPPORTUNITY_USE_LLM=false
LLM_PROVIDER=null
LLM_DAILY_COST_CAP_USD=1.00
ANTHROPIC_API_KEY=

# ---------- Shopee (Fase 9) ----------
SHOPEE_API_URL=https://open-api.affiliate.shopee.br/graphql
SHOPEE_APP_ID=
SHOPEE_SECRET=

# ---------- Meta (Fase 4) ----------
META_API_VERSION=v21.0
META_AD_ACCOUNT_ID=
META_ACCESS_TOKEN=
